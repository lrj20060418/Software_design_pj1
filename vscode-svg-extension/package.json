{
  "name": "svg-explorer-badge",
  "displayName": "SVG Explorer Badge & Outline",
  "description": "Explorer [] badge and Outline tree for .svg files (PJ1 Phase 2)",
  "version": "0.2.0",
  "publisher": "pj1-phase2",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:xml",
    "onLanguage:svg"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "svg",
        "aliases": ["SVG"],
        "extensions": [".svg"]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check:v0": "node scripts/check-v0.mjs",
    "check:v1": "node scripts/check-v1.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
